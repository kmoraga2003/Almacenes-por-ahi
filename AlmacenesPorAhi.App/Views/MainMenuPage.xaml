<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlmacenesPorAhi.App.Views.MainMenuPage"
             Title="Menú Principal">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="Menú Principal"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Frame>
            <VerticalStackLayout Spacing="12">
                <Label Text="Seleccione el módulo a utilizar" FontAttributes="Bold" />
                <Button Text="Inventario" Clicked="OnInventoryClicked" />
                <Button Text="Ventas" Clicked="OnSalesClicked" />
                <Button Text="Devoluciones" Clicked="OnReturnsClicked" BackgroundColor="{StaticResource AccentColor}" />
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>
