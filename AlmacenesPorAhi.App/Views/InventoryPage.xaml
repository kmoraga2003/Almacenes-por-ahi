<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlmacenesPorAhi.App.Views.InventoryPage"
             Title="Inventario">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Frame>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Gestionar Productos" FontSize="20" FontAttributes="Bold" />
                    <Entry Placeholder="Nombre del producto" Text="{Binding ProductName}" />
                    <Entry Placeholder="Precio" Keyboard="Numeric" Text="{Binding ProductPrice}" />
                    <Entry Placeholder="Stock" Keyboard="Numeric" Text="{Binding ProductStock}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Guardar" Command="{Binding SaveProductCommand}" />
                        <Button Text="Limpiar" Command="{Binding ClearFormCommand}" BackgroundColor="#94A3B8" />
                    </HorizontalStackLayout>
                    <Button Text="Eliminar seleccionado" Command="{Binding DeleteProductCommand}" BackgroundColor="{StaticResource DangerColor}" />
                    <Label Text="{Binding StatusMessage}" TextColor="{StaticResource AccentColor}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Productos disponibles" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Products}" SelectionMode="Single" SelectedItem="{Binding SelectedProduct}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Price, StringFormat='Precio: {0:C}'}" />
                                <Label Text="{Binding Stock, StringFormat='Stock: {0}'}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
