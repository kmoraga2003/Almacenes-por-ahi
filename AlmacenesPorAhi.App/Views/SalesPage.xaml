<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlmacenesPorAhi.App.Views.SalesPage"
             Title="Ventas">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Frame>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Registrar Venta" FontSize="20" FontAttributes="Bold" />
                    <Picker Title="Seleccione un producto"
                            ItemsSource="{Binding Products}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedProduct}" />
                    <Entry Placeholder="Cantidad" Keyboard="Numeric" Text="{Binding Quantity}" />
                    <Button Text="Registrar Venta" Command="{Binding RegisterSaleCommand}" />
                    <Label Text="{Binding StatusMessage}" TextColor="{StaticResource AccentColor}" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
